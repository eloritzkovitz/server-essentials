{
  "name": "@eloritzkovitz/server-essentials",
  "version": "1.1.0",
  "description": "A collection of reusable libraries, utilities and helpers to accelerate Node.js server development.",
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon",
    "docs": "typedoc --out docs --entryPoints src/index.ts src/auth src/config src/files src/formatting src/gateway src/logging src/messaging src/server src/validation --entryPointStrategy expand",
    "lint": "eslint . --ext .ts",
    "test": "vitest run --coverage"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "nodejs",
    "express",
    "utilities"
  ],
  "author": "Elor Itzkovitz",
  "repository": {
    "type": "git",
    "url": "https://github.com/eloritzkovitz/server-essentials.git"
  },
  "dependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/http-proxy": "1.17.17",
    "@types/multer": "2.2.0",
    "amqplib": "2.0.1",
    "axios": "1.19.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "google-auth-library": "11.0.2",
    "http-proxy": "1.18.1",
    "jsonwebtoken": "9.0.3",
    "multer": "2.2.0",
    "nodemailer": "9.0.5",
    "path-to-regexp": "8.4.2",
    "uuid": "14.0.2",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "copyfiles": "^2.4.1",
    "eslint": "10.8.1",
    "nodemon": "3.1.14",
    "supertest": "7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
